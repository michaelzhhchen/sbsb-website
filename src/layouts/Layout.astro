---
import "../styles/global.css";

import { Image } from "astro:assets";
import NavLink from "../components/navLink.astro";
import SocialLink from "../components/socialLink.astro";
import logoImage from "../assets/logo.png";

const { title, img, alt } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | SBSB</title>
  </head>
  <body class="flex min-h-screen flex-col bg-black text-white">
    {img && <Image src={img} alt={alt} class="fixed -z-10 h-screen w-screen" />}
    <header class="flex flex-col items-center justify-center gap-5 py-5">
      <Image src={logoImage} alt="SBSB logo" class="w-52" />
      <nav class="flex w-screen items-center justify-center gap-15 text-xl">
        <NavLink href="/">Home</NavLink>
        <NavLink href="/about">About</NavLink>
        <NavLink href="/members">Members</NavLink>
        <NavLink href="/videos">Videos</NavLink>
        <NavLink href="/albums">Albums</NavLink>
        <NavLink href="/donate">Donate</NavLink>
        <NavLink href="/audition">Audition</NavLink>
        <NavLink href="/contact">Contact</NavLink>
      </nav>
    </header>
    <slot />
    <footer
      class="mt-auto grid grid-cols-3 items-center justify-items-center px-32 py-10"
    >
      <p>© Something Borrowed Something Blue</p>
      <div class="flex items-center justify-start gap-2">
        <SocialLink
          platform="youtube"
          link="https://www.youtube.com/user/borrowednblue"
        />
        <SocialLink
          platform="spotify"
          link="https://open.spotify.com/artist/7hEZd0gUXJxxXGgMsIPmvG?si=zq80GAn4RfWHTEEztV8-wg"
        />
        <SocialLink
          platform="facebook"
          link="https://www.facebook.com/somethingborrowedsomethingblue"
        />
      </div>
      <a href="mailto:dukesbsb@gmail.com">dukesbsb@gmail.com</a>
    </footer>
  </body>
</html>
