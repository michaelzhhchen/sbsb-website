---
import "../styles/global.css";

import { Image } from "astro:assets";
import NavLink from "../components/navLink.astro";
import Socials from "../components/socials.astro";
import logoImage from "../assets/logo.png";

const { title, img, alt } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | SBSB</title>
  </head>
  <body class="flex min-h-screen flex-col bg-black text-white">
    {
      img && (
        <Image
          src={img}
          alt={alt}
          class="fixed -z-10 h-screen w-screen object-cover"
        />
      )
    }
    <header class="flex flex-col items-center justify-center gap-5 py-5">
      <Image src={logoImage} alt="SBSB logo" class="w-52" />
      <nav
        class="flex w-screen flex-wrap items-center justify-center gap-x-15 gap-y-1 text-xl"
      >
        <NavLink href="/">Home</NavLink>
        <NavLink href="/about">About</NavLink>
        <NavLink href="/members">Members</NavLink>
        <NavLink href="https://www.youtube.com/@borrowednblue/featured"
          >Videos</NavLink
        >
        <NavLink href="/albums">Albums</NavLink>
        <NavLink href="/donate">Donate</NavLink>
        <NavLink href="/audition">Audition</NavLink>
        <NavLink href="/contact">Contact</NavLink>
      </nav>
    </header>
    <slot />
    <footer
      class="mt-auto grid grid-cols-1 items-center justify-items-center gap-3 px-32 py-10 md:grid-cols-3"
    >
      <p class="text-center">© Something Borrowed Something Blue</p>
      <Socials />
      <a href="mailto:dukesbsb@gmail.com">dukesbsb@gmail.com</a>
    </footer>
  </body>
</html>
