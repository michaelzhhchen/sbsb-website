---
import Image from "astro/components/Image.astro";
import type { Records, FieldSet, Attachment } from "airtable";
import airtable from "../utils/airtable";

import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/socialLink.astro";
import albumsImage from "../assets/albums.jpg";
import playImage from "../assets/play.svg";

const albumsTable = airtable.table("Albums");
const songsTable = airtable.table("Songs");

const albums = await albumsTable
  .select({ sort: [{ field: "Release Year", direction: "desc" }] })
  .all();

const songsByAlbum: { [id: string]: Records<FieldSet> } = {};
for (const album of albums) {
  songsByAlbum[album.id] = await Promise.all(
    (album.get("Songs") as string[]).map((s) => songsTable.find(s)),
  );
}

const timestampify = (s: number) => {
  const mins = Math.floor(s / 60);
  const seconds = Math.round(s - mins * 60);

  return `${mins}:${seconds < 10 ? "0" : ""}${seconds}`;
};
---

<Layout title="Albums" img={albumsImage} alt="SBSB performing on stage">
  <div class="flex flex-col items-center gap-5">
    {
      albums.map((album) => (
        <div class="flex w-5/6 flex-col items-center justify-start gap-5 rounded-2xl bg-[#00000066] p-5 backdrop-blur-xl md:w-1/2">
          <div class="grid w-full grid-cols-2 items-center justify-items-center">
            {album.get("Cover") && (
              <Image
                src={((album.get("Cover") as Attachment[]) ?? [])[0]?.url}
                alt={`Album cover for ${album.get("Name")}`}
                width={200}
                height={200}
              />
            )}
            <div class="flex flex-col items-center justify-start gap-5">
              <p class="text-center text-3xl font-bold">{album.get("Name")}</p>
              <p class="text-2xl">{album.get("Release Year")}</p>
              <div class="hidden items-center justify-center gap-5 md:flex">
                {album.get("Spotify") && (
                  <SocialLink platform="spotify" link={album.get("Spotify")} />
                )}
                {album.get("Apple Music") && (
                  <SocialLink
                    platform="appleMusic"
                    link={album.get("Apple Music")}
                  />
                )}
                {album.get("YouTube Music") && (
                  <SocialLink
                    platform="youtubeMusic"
                    link={album.get("YouTube Music")}
                  />
                )}
              </div>
            </div>
          </div>

          <div class="flex items-center justify-center gap-5 md:hidden">
            {album.get("Spotify") && (
              <SocialLink platform="spotify" link={album.get("Spotify")} />
            )}
            {album.get("Apple Music") && (
              <SocialLink
                platform="appleMusic"
                link={album.get("Apple Music")}
              />
            )}
            {album.get("YouTube Music") && (
              <SocialLink
                platform="youtubeMusic"
                link={album.get("YouTube Music")}
              />
            )}
          </div>

          <hr class="h-[1px] w-full bg-white" />

          {songsByAlbum[album.id].map((track) => (
            <div class="sbsbTrack w-full">
              <div class="group text-md flex min-h-9 w-full items-center justify-between md:text-lg">
                <div class="flex items-center gap-3">
                  <p class="flex h-7 min-w-7 items-center justify-center rounded-full bg-white p-1 text-center text-sm font-semibold text-black">
                    <span
                      class={track.get("Audio") ? "group-hover:hidden" : ""}
                    >
                      {track.get("Track Number")}
                    </span>
                    {track.get("Audio") && (
                      <button
                        class="playButton hidden h-3 w-3 group-focus-within:block group-hover:block group-focus:block focus:block"
                        data-url={(track.get("Audio") as Attachment[])[0].url}
                      >
                        <Image src={playImage} alt="Play icon" />
                      </button>
                    )}
                  </p>
                  <p>{track.get("Name")}</p>
                </div>

                <div class="flex items-center gap-3">
                  <div class="flex gap-3 justify-self-start opacity-0 transition-all duration-200 group-focus-within:opacity-100 group-hover:opacity-100 group-focus:opacity-100 focus:opacity-100">
                    {track.get("Spotify") && (
                      <SocialLink
                        platform="spotify"
                        link={track.get("Spotify")}
                      />
                    )}
                    {track.get("Apple Music") && (
                      <SocialLink
                        platform="appleMusic"
                        link={track.get("Apple Music")}
                      />
                    )}
                    {track.get("YouTube Music") && (
                      <SocialLink
                        platform="youtubeMusic"
                        link={track.get("YouTube Music")}
                      />
                    )}
                  </div>
                  <p class="min-w-12">
                    {timestampify(track.get("Duration") as number)}
                  </p>
                </div>
              </div>
              <div class="trackLinks hidden w-full items-center justify-center gap-3">
                {track.get("Spotify") && (
                  <SocialLink platform="spotify" link={track.get("Spotify")} />
                )}
                {track.get("Apple Music") && (
                  <SocialLink
                    platform="appleMusic"
                    link={track.get("Apple Music")}
                  />
                )}
                {track.get("YouTube Music") && (
                  <SocialLink
                    platform="youtubeMusic"
                    link={track.get("YouTube Music")}
                  />
                )}
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</Layout>

<script>
  document.querySelectorAll(".playButton").forEach((e) => {
    e.addEventListener("click", (e) => {
      const audioUrl = (e.target as HTMLButtonElement).dataset.url;
      if (audioUrl) {
        const audio = new Audio(audioUrl);
        audio.play();
      }
    });
  });

  if (window.innerWidth < 768) {
    document.querySelectorAll(".sbsbTrack").forEach((e) => {
      e.addEventListener("click", (ev) => {
        const links = e.querySelector(".trackLinks");
        if (links?.classList.contains("hidden")) {
          links.classList.remove("hidden");
          links.classList.add("flex");
        } else {
          links?.classList.remove("flex");
          links?.classList.add("hidden");
        }
      });
    });
  }
</script>
