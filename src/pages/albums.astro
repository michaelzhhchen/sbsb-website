---
import Image from "astro/components/Image.astro";
import type { Records, FieldSet, Attachment } from "airtable";
import airtable from "../utils/airtable";

import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/socialLink.astro";
import albumsImage from "../assets/albums.jpg";

const albumsTable = airtable.table("Albums");
const songsTable = airtable.table("Songs");

const albums = await albumsTable
  .select({ sort: [{ field: "Release Year", direction: "desc" }] })
  .all();

const songsByAlbum: { [id: string]: Records<FieldSet> } = {};
for (const album of albums) {
  songsByAlbum[album.id] = await Promise.all(
    (album.get("Songs") as string[]).map((s) => songsTable.find(s)),
  );
}

const timestampify = (s: number) => {
  const mins = Math.floor(s / 60);
  const seconds = Math.round(s - mins * 60);

  return `${mins}:${seconds < 10 ? "0" : ""}${seconds}`;
};
---

<Layout title="Albums" img={albumsImage} alt="SBSB performing on stage">
  <div class="flex flex-col items-center gap-5">
    {
      albums.map((album) => (
        <div class="flex w-1/2 flex-col items-center justify-start gap-5 rounded-2xl bg-[#00000066] p-5 backdrop-blur-xl">
          <div class="grid w-full grid-cols-2 items-center justify-items-center">
            {album.get("Cover") && (
              <Image
                src={((album.get("Cover") as Attachment[]) ?? [])[0]?.url}
                alt={`Album cover for ${album.get("Name")}`}
                width={200}
                height={200}
              />
            )}
            <div class="flex flex-col items-center justify-start gap-5">
              <p class="text-center text-3xl font-bold">{album.get("Name")}</p>
              <p class="text-2xl">{album.get("Release Year")}</p>
              <div class="flex items-center justify-center gap-5">
                {album.get("Spotify") && (
                  <SocialLink platform="spotify" link={album.get("Spotify")} />
                )}
                {album.get("Apple Music") && (
                  <SocialLink
                    platform="appleMusic"
                    link={album.get("Apple Music")}
                  />
                )}
                {album.get("YouTube Music") && (
                  <SocialLink
                    platform="youtubeMusic"
                    link={album.get("YouTube Music")}
                  />
                )}
              </div>
            </div>
          </div>

          <hr class="h-[1px] w-full bg-white" />

          {songsByAlbum[album.id].map((track) => (
            <div class="flex w-full items-start justify-between text-lg">
              <div class="flex items-center gap-3">
                <p class="min-w-8">{track.get("Track Number")}</p>
                <p>{track.get("Name")}</p>
              </div>

              <p>{timestampify(track.get("Duration") as number)}</p>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</Layout>
