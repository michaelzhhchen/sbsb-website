---
import { type Attachment } from "airtable";
import { base, downloadedFile } from "../../utils/airtable";

import Layout from "../../layouts/Layout.astro";
import Image from "astro/components/Image.astro";

import membersImage from "../../assets/members.jpg";

const membersTable = base.table("Members");

const alumni = await membersTable.select({ view: "Alumni" }).all();

const fileUrls: { [id: string]: string } = {};
for (const alum of alumni) {
  fileUrls[alum.id] = await downloadedFile(
    ((alum.get("Picture") as Attachment[]) ?? [])[0]?.url,
  );
}
---

<Layout title="Alumni" img={membersImage} alt="SBSB performing on stage">
  <div class="mx-5 flex flex-col items-center justify-start">
    <div
      class="grid grid-cols-4 gap-5 rounded-2xl bg-[#00000055] p-5 backdrop-blur-lg md:grid-cols-5"
    >
      {
        alumni.toReversed().map((alum) => (
          <>
            <div class="flex flex-col items-center justify-center gap-1">
              <Image
                src={fileUrls[alum.id]}
                alt={`Picture of ${alum.get("Name")}`}
                width={125}
                height={125}
                class="aspect-square object-cover"
              />
              <p class="text-md text-center font-bold md:text-lg">
                {alum.get("Name")}
              </p>
              <p class="text-md text-center md:text-lg">
                '{alum.get("Graduation Year")?.toString().slice(2)} -
                {alum.get("Part")}
              </p>
            </div>
          </>
        ))
      }
    </div>
  </div>
</Layout>
