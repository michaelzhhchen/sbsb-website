---
import { youtube, youtube_v3 } from "@googleapis/youtube";
import { getSecret } from "astro:env/server";

import Layout from "../layouts/Layout.astro";
import membersImage from "../assets/members.jpg";

const playlists = [];
let nextPageToken;

do {
  const res = await youtube("v3").playlists.list({
    key: getSecret("YOUTUBE_API_KEY"),
    channelId: "UCUY9DlaMz6edyjdSCakImrw",
    part: ["snippet"],
    maxResults: 1,
  });

  if (res.data.items) {
    playlists.push(
      ...res.data.items.map((item) => ({
        id: item.id,
        title: item.snippet?.title,
        items: [] as youtube_v3.Schema$PlaylistItem[],
      })),
    );
  }

  // nextPageToken = res.data.nextPageToken;
} while (!!nextPageToken);

const playlistItemPromises = playlists.map((playlist) => {
  return youtube("v3").playlistItems.list({
    key: getSecret("YOUTUBE_API_KEY"),
    playlistId: playlist?.id!,
    maxResults: 10,
    part: ["snippet"],
  });
});

const playlistItems = await Promise.allSettled(playlistItemPromises);
for (let i = 0; i < playlistItems.length; i++) {
  const res = playlistItems[i];
  console.log(res);

  if (res.status === "fulfilled") {
    console.log(res.value.data.items);
    playlists[i].items = res.value.data.items ?? [];
  } else {
    playlists[i].items = [];
  }
}
---

<Layout title="Videos" img={membersImage} alt="SBSB performing on stage">
  <div class="flex flex-col items-start justify-start">
    {
      playlists.map((playlist) => (
        <div class="flex flex-col items-start justify-start gap-5">
          <p>{playlist.title}</p>
          <div class="flex items-center justify-start gap-5">
            {playlist.items.map((item) => (
              <div>
                <img
                  src={item.snippet?.thumbnails?.default?.url}
                  width={100}
                  height={40}
                  alt="Video thumbnail"
                />
                <p class="text-xl font-bold">{item.snippet?.title}</p>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Layout>
