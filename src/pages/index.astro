---
import Layout from "../layouts/Layout.astro";

import homeImage from "../assets/home.jpg";
---

<Layout title="Home" img={homeImage} alt="SBSB performing on stage">
  <div
    class="mx-5 flex flex-col items-center gap-7 rounded-2xl bg-[#00000066] p-5 pt-7 backdrop-blur-xl md:bg-transparent md:backdrop-blur-none"
  >
    <h1 class="text-center text-5xl font-bold">
      Something Borrowed<br /> Something Blue
    </h1>
    <p class="text-center text-2xl font-semibold italic">
      Duke University's Premiere Christian Co-ed A Capella Group
    </p>
  </div>
</Layout>
